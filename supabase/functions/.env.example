# =============================================================================
# Supabase Edge Functions — Developer Environment Template
# =============================================================================
# Copy this file to `.env.dev` (or `.env` for `supabase functions serve`) and
# fill in the values for your local stack.
#
# Conventions:
#   - Vars marked (REQUIRED) must be set; edge functions will not start without
#     them (or will fail at first call).
#   - Vars marked (OPTIONAL) have safe defaults and can be left commented out.
#   - Mock URLs target the local mock server on http://127.0.0.1:8083.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase runtime (auto-injected in prod; REQUIRED for `supabase functions serve`)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321                                              # (REQUIRED) Local Supabase project URL
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0  # (REQUIRED) Anon key (respects RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU  # (REQUIRED) Service role key (bypasses RLS; admin only)
SUPABASE_PROJECT_URL=http://127.0.0.1:54321                                      # (REQUIRED for self-hosted/prod) Public Supabase URL (e.g., https://db.yourdomain.com)
LEADMINER_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0  # Legacy alias; equals SUPABASE_ANON_KEY
LEADMINER_API_HASH_SECRET=change_me                                             # (REQUIRED) Used for hashing/verifying short tokens

# -----------------------------------------------------------------------------
# Backend / inter-service endpoints
# -----------------------------------------------------------------------------
SERVER_ENDPOINT=http://localhost:8081                                            # (REQUIRED) URL of the Backend (Express) API
EMAILS_FETCHER_URL=http://localhost:7778                                         # (REQUIRED for IMAP) Used for IMAP box listing
FRONTEND_HOST="http://localhost:8082"                                           # (REQUIRED) Frontend base URL (used in emails, OAuth redirects, links)
OAUTH_CALLBACK_BASE_URL=http://localhost:54321                                   # (REQUIRED) Public Supabase URL for OAuth callback

# -----------------------------------------------------------------------------
# SMTP / email campaigns (use an Ethereal account for local dev: https://ethereal.email/)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.email
SMTP_PORT=587
SMTP_USER=your-secret-smtp-username
SMTP_PASS=your-secret-smtp-password
campaign_compliance_footer=                                                      # (OPTIONAL) Footer text appended to every campaign email
LOGO_URL="https://db.leadminer.io/storage/v1/object/public/templates/LogoWithIcon.png"

# -----------------------------------------------------------------------------
# OAuth providers (Google + Microsoft/Azure)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id                                          # (REQUIRED) Google OAuth client ID
GOOGLE_SECRET=your_google_client_secret                                         # (REQUIRED) Google OAuth client secret
AZURE_CLIENT_ID=your_azure_client_id                                            # (REQUIRED) Azure/Microsoft OAuth client ID
AZURE_SECRET=your_azure_client_secret                                           # (REQUIRED) Azure/Microsoft OAuth client secret

# -----------------------------------------------------------------------------
# SMS campaigns — Twilio (cloud)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid                                      # (REQUIRED for Twilio)
TWILIO_AUTH_TOKEN=your_twilio_auth_token                                        # (REQUIRED for Twilio)
TWILIO_FROM_NUMBER=+1234567890                                                  # (REQUIRED for Twilio)

# -----------------------------------------------------------------------------
# SMS campaigns — SMSGate (self-hosted Android gateway)
# -----------------------------------------------------------------------------
SMSGATE_BASE_URL=https://api.sms-gate.app
SMSGATE_USERNAME=your_smsgate_username
SMSGATE_PASSWORD=your_smsgate_password

# -----------------------------------------------------------------------------
# SMS campaign limits (0 = unlimited)
# -----------------------------------------------------------------------------
SMS_CAMPAIGN_DAILY_LIMIT=200
SMS_CAMPAIGN_MONTHLY_RECIPIENT_LIMIT=200

# -----------------------------------------------------------------------------
# Enrichment service providers (mock URLs target the local mock server on :8083)
# -----------------------------------------------------------------------------
ENRICHLAYER_URL=http://127.0.0.1:8083/enrichlayer                               # (REQUIRED for enrich function)
ENRICHLAYER_API_KEY=test-api-key
THEDIG_URL=http://127.0.0.1:8083/thedig                                         # (REQUIRED for enrich function)
THEDIG_API_KEY=test-api-key
VOILANORBERT_URL=http://127.0.0.1:8083/voilanorbert                             # (REQUIRED for enrich function)
VOILANORBERT_USERNAME=test-user
VOILANORBERT_API_KEY=test-api-key

# -----------------------------------------------------------------------------
# OpenWA (WhatsApp automation)
# -----------------------------------------------------------------------------
OPENWA_API_URL=http://127.0.0.1:8083/openwa                                     # (REQUIRED for whatsapp-campaigns)
OPENWA_API_KEY=test-api-key
OPENWA_BASE_URL=http://127.0.0.1:8083/openwa
OPENWA_WEBHOOK_SECRET=test-webhook-secret                                       # (REQUIRED for whatsapp-webhook)

# -----------------------------------------------------------------------------
# Email-campaign fallback sender
# -----------------------------------------------------------------------------
FALLBACK_SENDER_ENABLED=true                                                    # (OPTIONAL, default true) Allow the system to send via a fallback SMTP sender when a user's SMTP is unavailable

# -----------------------------------------------------------------------------
# App / runtime config
# -----------------------------------------------------------------------------
APP_NAME=Leadminer                                                              # (OPTIONAL, default "Leadminer") App name used in exports (vCard category, Google export)
DENO_ENV=development                                                            # (OPTIONAL) "development" | "production" — controls log verbosity in _shared/logger.ts
LOG_LEVEL=debug                                                                 # (OPTIONAL) "debug" | "info" | "warn" | "error"
REDIS_URL=                                                                      # (OPTIONAL) Leave empty to fall back to the in-memory rate limiter (see _shared/rate-limiter.ts)
# REDIS_URL=redis://localhost:6379
