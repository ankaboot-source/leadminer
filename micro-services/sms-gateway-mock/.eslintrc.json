{
  "extends": ["airbnb-base", "airbnb-typescript/base", "prettier"],
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "import/extensions": "off"
      }
    }
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint"],
  "root": true,
  "rules": {
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "never",
        "jsx": "never",
        "ts": "never",
        "tsx": "never"
      }
    ],
    "no-continue": 0,
    "no-restricted-syntax": 0,
    "radix": 0
  }
}
