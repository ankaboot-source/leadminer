{
  "name": "@leadminer/sms-gateway-mock-service",
  "version": "1.0.0",
  "description": "Development-only mock SMS gateway service (simple-sms-gateway + smsgate).",
  "author": "Ankaboot.io",
  "license": "GNU AGPL v3",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "bun --watch src/server.ts",
    "inspect": "bun --inspect src/server.ts",
    "start": "bun src/server.ts",
    "test:unit": "jest ./test/unit",
    "test-ci:unit": "jest ./test/unit --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "keywords": [
    "sms",
    "mock",
    "gateway",
    "microservice",
    "bun",
    "express",
    "leadminer"
  ],
  "dependencies": {
    "@sentry/node": "^8.55.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "winston": "^3.19.0",
    "winston-loki": "6.1.3",
    "zod": "^3.25.76",
    "zod-error": "^1.5.0"
  },
  "resolutions": {
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.13",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "prettier": "3.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
